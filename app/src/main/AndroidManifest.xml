<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.jcc.probe">
    <instrumentation android:name=".OcrChecks" android:targetPackage="local.jcc.probe" android:label="Read-only OCR fixture check" />
    <application android:label="金铲铲截图验证" android:extractNativeLibs="true" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".CaptureService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="金铲铲截图验证">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/capture_service" />
        </service>
    </application>
</manifest>
